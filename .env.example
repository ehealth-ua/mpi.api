# Define your environment variables here in a FOO="bar" format.
#
# Copy this file to .env and fill in real values. Never commit .env.
#
# This cookie is used for authorization purposes when you join Erlang VM nodes into cluster
ERLANG_COOKIE=

# Database settings
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Database read-only settings
READ_DB_NAME=
READ_DB_USER=
READ_DB_PASSWORD=
READ_DB_HOST=
READ_DB_PORT=

# Database settings
DB_DEDUPLICATION_NAME=
DB_DEDUPLICATION_USER=
DB_DEDUPLICATION_PASSWORD=
DB_DEDUPLICATION_HOST=
DB_DEDUPLICATION_PORT=

# Seed and migrate DB on start
DB_MIGRATE=

# Kafka brokers
KAFKA_BROKERS=

# Phoenix endpoint settings
APP_PORT=
APP_HOST=
APP_SECRET_KEY=

# Configure Logger severity
LOG_LEVEL=

MAX_PERSONS_RESULT=
POD_A_RECORD=
NAMESPACE=
